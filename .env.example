# App
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_SECRET=
ALLOWED_ORIGINS=localhost:3000
ADMIN_EMAILS=

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/novaquill
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/novaquill

# Auth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Encryption
# Generate with: openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=

# Cloudinary document storage
# Required in production. Signed PDFs are encrypted before upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis rate limiting
# Strongly recommended in production/serverless environments.
REDIS_URL=

# PayFast
PAYFAST_ENV=sandbox
# Enable live payments only after actual merchant approval, policy update and verified integration.
PAYFAST_PAYMENTS_ENABLED=false
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Public company details for the privacy/PAIA notice (never put secrets in these fields)
PRIVACY_LEGAL_NAME=
PRIVACY_ENTITY_TYPE=company
PRIVACY_REGISTRATION_NUMBER=
PRIVACY_BUSINESS_ADDRESS=
PRIVACY_CONTACT_EMAIL=
PRIVACY_INFORMATION_OFFICER=
PRIVACY_CONTACT_PHONE=
PRIVACY_PLACE_OF_REGISTRATION=
PRIVACY_OFFICE_BEARERS=
# Private compliance evidence reference; not returned by the public notice endpoint
PRIVACY_IO_REGISTRATION_REFERENCE=
PRIVACY_OPERATOR_REFERENCE=

# Retention maintenance: configure approved operational periods, then schedule the protected endpoint
CRON_SECRET=
SECURITY_LOG_RETENTION_DAYS=90
PRIVACY_REQUEST_RETENTION_DAYS=365
